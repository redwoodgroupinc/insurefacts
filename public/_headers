# Response headers for Cloudflare (Workers static assets or Pages).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Files in /_astro/ have a content hash in their names, so they can be cached for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/flags/*
  Cache-Control: public, max-age=604800

/icons/*
  Cache-Control: public, max-age=604800

# Keep the *.workers.dev preview address out of search results; only insurefacts.net is indexed.
https://:name.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
