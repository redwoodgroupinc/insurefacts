---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import AdSlot from '../../../components/AdSlot.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Callout from '../../../components/Callout.astro';
import Icon from '../../../components/Icon.astro';
import { categoryUrl, getCategory } from '../../../data/categories';
import { getCountry } from '../../../data/countries';
import { site } from '../../../data/site';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { adSlotHtml } from '../../../lib/ads';
import {
  articleUrl,
  getArticles,
  needsReview,
  readingTime,
  type Article,
} from '../../../lib/articles';
import { countryName, formatDate, isoDate } from '../../../lib/format';
import { articleSchema, breadcrumbSchema, type Crumb } from '../../../lib/schema';

export const getStaticPaths = (async () => {
  const articles = await getArticles();
  return articles.map((article) => {
    const [country, category, slug] = article.id.split('/');
    return { params: { country, category, slug }, props: { article } };
  });
}) satisfies GetStaticPaths;

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { data } = article;
const country = getCountry(data.country);
const category = getCategory(data.country, data.category)!;
const { Content, headings } = await render(article);

const sections = headings.filter((h) => h.depth === 2);
const minutes = readingTime(article.body);
const showReviewNotice = needsReview(data.updatedDate);
const related = (await getArticles())
  .filter(
    (a) => a.id !== article.id && a.data.country === data.country && a.data.category === data.category,
  )
  .slice(0, 3);

// Mid-article ad: inserted just before the 4th H2 (i.e. after the 3rd section), only in
// Markdown articles long enough to have four sections. MDX articles render without it.
const html = article.rendered?.html;
let bodyHtml: string | undefined;
if (html && article.filePath?.endsWith('.md') && !html.includes('__ASTRO_IMAGE_')) {
  const h2Positions = [...html.matchAll(/<h2[\s>]/g)].map((m) => m.index ?? 0);
  bodyHtml =
    h2Positions.length >= 4
      ? html.slice(0, h2Positions[3]) + adSlotHtml('mid-article') + html.slice(h2Positions[3])
      : html;
}

const path = articleUrl(article);
const crumbs: Crumb[] = [
  { name: 'Home', href: '/' },
  { name: country.name, href: `/${country.code}/` },
  { name: category.name, href: categoryUrl(category) },
  { name: data.title },
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  country={country.code}
  ogType="article"
  noindex={data.draft}
  publishedTime={data.publishedDate}
  modifiedTime={data.updatedDate}
  jsonLd={[
    articleSchema({
      title: data.title,
      description: data.description,
      path,
      author: data.author,
      publishedDate: data.publishedDate,
      updatedDate: data.updatedDate,
      lang: country.lang,
      sourceUrls: data.sources.map((s) => s.url),
    }),
    breadcrumbSchema(crumbs, path),
  ]}
>
  <div class="container-page">
    <div class="mx-auto max-w-3xl pt-2">
      <Breadcrumbs crumbs={crumbs} />

      <article
        class="mt-4"
        data-pagefind-body
        data-pagefind-filter={`Country:${country.name}`}
        aria-labelledby="article-title"
      >
        {
          data.draft && (
            <div class="mb-6" data-pagefind-ignore>
              <Callout variant="important" title="Draft: not published">
                <p>
                  This article is a draft. It only appears in local previews and is never included in
                  the live site, search or sitemap. Check every fact against the sources before setting{' '}
                  <code>draft: false</code>.
                </p>
              </Callout>
            </div>
          )
        }

        <header>
          <h1 id="article-title" class="text-[2rem] leading-tight font-bold tracking-tight sm:text-[2.5rem]">
            {data.title}
          </h1>
          <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.9375rem] text-fg-muted" data-pagefind-ignore>
            <span>By <span class="font-medium text-fg">{data.author}</span></span>
            <span aria-hidden="true">·</span>
            <span>
              Last updated <time datetime={isoDate(data.updatedDate)}>{formatDate(data.updatedDate, country.lang)}</time>
            </span>
            <span aria-hidden="true">·</span>
            <span class="inline-flex items-center gap-1">
              <Icon name="clock" size={16} />
              {minutes} min read
            </span>
          </p>
        </header>

        {
          showReviewNotice && (
            <p class="mt-4 flex items-center gap-2 rounded-lg bg-bg-subtle px-4 py-2.5 text-[0.9375rem] text-fg-muted" data-pagefind-ignore>
              <Icon name="refresh" size={18} class="shrink-0" />
              This article is being reviewed for updates.
            </p>
          )
        }

        <section
          aria-labelledby="quick-answer-title"
          class="mt-8 rounded-xl border border-accent/40 border-l-4 border-l-accent bg-accent-soft px-5 py-5 sm:px-6"
        >
          <h2 id="quick-answer-title" class="text-sm font-bold tracking-wide text-accent uppercase">
            Quick answer
          </h2>
          <p class="mt-2 text-lg leading-relaxed text-heading">{data.quickAnswer}</p>
        </section>

        <AdSlot position="after-quick-answer" />

        {
          sections.length > 1 && (
            <>
              <details class="toc card mt-8 overflow-hidden" data-pagefind-ignore>
                <summary class="flex min-h-12 cursor-pointer items-center justify-between gap-2 px-5 font-semibold text-heading">
                  On this page
                  <Icon name="chevronRight" size={20} class="toc-chevron shrink-0 transition-transform" />
                </summary>
                <nav aria-label="On this page" class="border-t border-border px-5 py-3">
                  <ol class="space-y-0.5">
                    {sections.map((h) => (
                      <li>
                        <a
                          href={`#${h.slug}`}
                          class="flex min-h-11 items-center text-[0.9375rem] text-accent underline-offset-4 hover:underline"
                        >
                          {h.text}
                        </a>
                      </li>
                    ))}
                  </ol>
                </nav>
              </details>
              <script is:inline>
                // Open the contents by default on wider screens; it stays collapsed on phones.
                if (window.matchMedia('(min-width: 768px)').matches) {
                  document.currentScript.previousElementSibling.open = true;
                }
              </script>
            </>
          )
        }

        <div class="prose mt-8">
          {bodyHtml !== undefined ? <Fragment set:html={bodyHtml} /> : <Content />}
        </div>

        {
          data.keyFacts && data.keyFacts.length > 0 && (
            <section aria-labelledby="key-facts-title" class="mt-10 rounded-xl border border-border bg-bg-subtle p-5 sm:p-6">
              <h2 id="key-facts-title" class="flex items-center gap-2 text-xl font-bold">
                <Icon name="checklist" size={22} class="text-accent" />
                Key facts
              </h2>
              <ul class="mt-3 space-y-2.5">
                {data.keyFacts.map((fact) => (
                  <li class="flex gap-3">
                    <Icon name="verified" size={20} class="mt-1 shrink-0 text-accent" />
                    <span>{fact}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

      <section aria-labelledby="sources-title" class="mt-12 border-t border-border pt-8" data-pagefind-ignore>
        <h2 id="sources-title" class="text-xl font-bold">Sources</h2>
        <p class="mt-1 text-[0.9375rem] text-fg-muted">
          The official sources used for this article. Links open in a new tab.
        </p>
        <ol class="mt-4 list-decimal space-y-3 pl-6 marker:text-fg-muted">
          {
            data.sources.map((source, i) => (
              <li id={`source-${i + 1}`} class="scroll-mt-6 pl-1">
                <span class="font-medium text-heading">{source.publisher}</span>:{' '}
                <a href={source.url} target="_blank" rel="noopener" class="link">
                  {source.title}
                  <Icon name="external" size={14} class="ml-0.5 inline-block align-[-1px]" />
                  <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <AdSlot position="after-sources" />

      <div class="mt-10" data-pagefind-ignore>
        <Callout variant="note" title="General information only" level={2} id="disclaimer">
          <p>
            This article explains how insurance works in {countryName(country)} in general terms. It is
            not financial advice and doesn’t take anyone’s personal circumstances into account.{' '}
            {site.name} is not an insurance company, agent or broker. Always check the details with the
            insurer or the official source before making a decision. Read our full{' '}
            <a href="/disclaimer/">disclaimer</a>.
          </p>
        </Callout>
      </div>
      </article>

      <section aria-labelledby="related-title" class="mt-12" data-pagefind-ignore>
        <h2 id="related-title" class="text-xl font-bold">Related articles</h2>
        {
          related.length > 0 ? (
            <ul class="mt-4 grid gap-4 sm:grid-cols-2">
              {related.map((a) => (
                <li>
                  <ArticleCard article={a} />
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-2 text-fg-muted">
              More articles on this topic are on the way. Browse{' '}
              <a href={categoryUrl(category)} class="link">{category.name.toLowerCase()} in {countryName(country)}</a>{' '}
              or <a href={`/${country.code}/`} class="link">all insurance types in {countryName(country)}</a>.
            </p>
          )
        }
      </section>

      <p class="mt-10 flex items-center gap-2 text-[0.9375rem] text-fg-muted" data-pagefind-ignore>
        <Icon name="info" size={18} class="shrink-0" />
        <span>Spotted an error? See our <a href="/corrections/" class="link">Corrections page</a>.</span>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .toc[open] .toc-chevron {
    transform: rotate(90deg);
  }
  .toc summary {
    list-style: none;
  }
  .toc summary::-webkit-details-marker {
    display: none;
  }
</style>
