---
import ArticleCard from '../components/ArticleCard.astro';
import Flag from '../components/Flag.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { categories, categoryUrl } from '../data/categories';
import { countries, getCountry } from '../data/countries';
import { site } from '../data/site';
import { popularTopics } from '../data/topics';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles } from '../lib/articles';
import { organizationSchema, websiteSchema } from '../lib/schema';

const recent = (await getArticles()).slice(0, 6);

const topics = popularTopics.map((t) => ({
  ...t,
  links: categories
    .filter((c) => c.topic === t.topic)
    .map((c) => ({ href: categoryUrl(c), country: getCountry(c.country) })),
}));

const principles = [
  {
    icon: 'sources',
    title: 'Official sources',
    text: 'Every article cites government departments, regulators and ombudsman services, with links so you can check the facts yourself.',
  },
  {
    icon: 'plain',
    title: 'Plain English',
    text: 'We explain how insurance works in clear language, using each country’s own terms, such as excess or deductible.',
  },
  {
    icon: 'refresh',
    title: 'Regularly updated',
    text: 'Each article shows when it was last updated, and we review articles when rules change and at least once a year.',
  },
] as const;
---

<BaseLayout
  title={`${site.name}: ${site.tagline}`}
  appendSiteName={false}
  description="Free, factual explanations of how insurance works in the US, UK, Canada and Australia. Plain English, official sources, no sales and no advice."
  jsonLd={[organizationSchema(), websiteSchema()]}
>
  <section class="relative overflow-hidden border-b border-border bg-bg-subtle">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_85%_0%,var(--accent-soft),transparent_55%)]"
      aria-hidden="true"
    >
    </div>
    <div class="container-page relative py-14 sm:py-20">
      <div class="max-w-3xl">
        <h1 class="text-[2.25rem] leading-tight font-bold tracking-tight sm:text-5xl">
          {site.tagline}
        </h1>
        <p class="mt-4 text-lg text-fg-muted sm:text-xl">
          Clear, sourced explanations of how insurance works in the United States, United Kingdom,
          Canada and Australia. No sales, no advice, just the facts.
        </p>

        <form action="/search/" method="get" role="search" class="mt-8" data-hero-search>
          <label for="hero-search" class="visually-hidden">Search InsureFacts</label>
          <div class="flex flex-col gap-2 sm:flex-row sm:gap-0">
            <div class="relative flex-1">
              <Icon
                name="search"
                size={22}
                class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-fg-muted"
              />
              <input
                id="hero-search"
                name="q"
                type="search"
                autocomplete="off"
                placeholder="Search, e.g. “excess”, “Medicare” or “green slip”"
                class="h-14 w-full rounded-xl border border-input-border bg-surface pr-4 pl-12 text-base text-fg shadow-card placeholder:text-fg-muted sm:rounded-r-none sm:text-lg"
              />
            </div>
            <button type="submit" class="btn-primary h-14 rounded-xl px-7 text-base sm:rounded-l-none">
              Search
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <section aria-labelledby="countries-title" class="container-page pt-14">
    <SectionHeading id="countries-title" title="Choose your country" />
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        countries.map((c) => (
          <li>
            <article class="card card-link relative flex h-full flex-col p-6">
              <Flag country={c} width={56} class="rounded-[4px]" />
              <h3 class="mt-4 text-xl font-semibold">
                <a href={`/${c.code}/`} class="stretched-link hover:text-accent hover:underline underline-offset-4">
                  {c.name}
                </a>
              </h3>
              <p class="mt-1 flex-1 text-fg-muted">{c.tagline}</p>
              <p class="mt-4 inline-flex items-center gap-1 text-[0.9375rem] font-semibold text-accent" aria-hidden="true">
                Explore guides <Icon name="chevronRight" size={18} />
              </p>
            </article>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="topics-title" class="container-page pt-16">
    <SectionHeading id="topics-title" title="Popular topics" />
    <ul class="grid gap-4 md:grid-cols-2">
      {
        topics.map((t) => (
          <li class="card flex flex-col p-5">
            <div class="flex items-center gap-3">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-accent-soft text-accent">
                <Icon name={t.icon} size={20} />
              </span>
              <h3 class="text-lg font-semibold">{t.name}</h3>
            </div>
            <ul class="mt-3 flex flex-wrap gap-2" aria-label={`${t.name} by country`}>
              {t.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-border px-3 text-[0.9375rem] font-medium hover:border-accent hover:text-accent"
                  >
                    <Flag country={link.country} width={18} />
                    {link.country.short}
                    <span class="visually-hidden">: {t.name.toLowerCase()} in {link.country.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="how-title" class="mt-16 border-y border-border bg-bg-subtle">
    <div class="container-page py-12">
      <h2 id="how-title" class="text-2xl font-bold sm:text-[1.75rem]">How we work</h2>
      <ul class="mt-6 grid gap-6 md:grid-cols-3">
        {
          principles.map((p) => (
            <li class="flex gap-4">
              <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-accent text-accent-fg">
                <Icon name={p.icon} size={20} />
              </span>
              <div>
                <h3 class="text-lg font-semibold">{p.title}</h3>
                <p class="mt-1 text-[0.9375rem] leading-relaxed text-fg-muted">{p.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="mt-8">
        <a href="/editorial-policy/" class="link inline-flex min-h-11 items-center gap-1 font-semibold">
          Read our editorial policy <Icon name="chevronRight" size={18} />
        </a>
      </p>
    </div>
  </section>

  <section aria-labelledby="recent-title" class="container-page pt-14">
    <SectionHeading id="recent-title" title="Recently updated" />
    {
      recent.length > 0 ? (
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {recent.map((article) => (
            <li>
              <ArticleCard article={article} showContext />
            </li>
          ))}
        </ul>
      ) : (
        <p class="card p-6 text-fg-muted">
          Our first articles are being researched and checked against official sources. They’ll appear
          here as soon as they’re published. In the meantime, each country page links to the official
          sources we use.
        </p>
      )
    }
  </section>
</BaseLayout>
