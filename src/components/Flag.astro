---
import type { Country } from '../data/countries';

interface Props {
  country: Country;
  class?: string;
  /** Rendered width in px; height follows the flag's 4:3 ratio. */
  width?: number;
}

const { country, class: className = '', width = 20 } = Astro.props;
---

<img
  src={country.flag}
  alt=""
  width={width}
  height={Math.round((width * 3) / 4)}
  decoding="async"
  class:list={['inline-block shrink-0 rounded-[2px] ring-1 ring-black/10', className]}
/>
