---
import { categoryUrl, type Category } from '../data/categories';
import Icon from './Icon.astro';

interface Props {
  category: Category;
  articleCount?: number;
}

const { category, articleCount = 0 } = Astro.props;
---

<article class="card card-link relative flex h-full gap-4 p-5">
  <span class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-accent-soft text-accent">
    <Icon name={category.icon} size={22} />
  </span>
  <div class="min-w-0">
    <h3 class="text-lg font-semibold leading-snug">
      <a
        href={categoryUrl(category)}
        class="stretched-link hover:text-accent hover:underline underline-offset-4"
      >
        {category.name}
      </a>
    </h3>
    <p class="mt-1 text-[0.9375rem] leading-relaxed text-fg-muted">{category.description}</p>
    {articleCount > 0 && (
      <p class="mt-2 text-sm font-medium text-fg">
        {articleCount} {articleCount === 1 ? 'article' : 'articles'}
      </p>
    )}
  </div>
</article>
