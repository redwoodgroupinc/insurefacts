---
import { icons, type IconName } from '../data/icons';

interface Props {
  name: IconName;
  class?: string;
  size?: number;
  strokeWidth?: number;
}

const { name, class: className = '', size = 24, strokeWidth = 2 } = Astro.props;

// Lucide ships complete <svg> strings; swap in our own attributes and keep the inner shapes.
const inner = icons[name].replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={inner}
/>
