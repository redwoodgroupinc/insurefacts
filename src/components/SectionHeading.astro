---
interface Props {
  title: string;
  id: string;
  eyebrow?: string;
}

const { title, id, eyebrow } = Astro.props;
---

<div class="mb-6 flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
  <div>
    {eyebrow && <p class="eyebrow mb-1">{eyebrow}</p>}
    <h2 id={id} class="text-2xl font-bold sm:text-[1.75rem]">
      {title}
    </h2>
  </div>
  <slot />
</div>
