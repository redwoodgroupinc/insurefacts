---
import type { OfficialLink } from '../data/countries';
import Icon from './Icon.astro';

interface Props {
  title: string;
  links: OfficialLink[];
  intro?: string;
  id?: string;
}

const { title, links, intro, id = 'official-sources' } = Astro.props;
---

<section
  aria-labelledby={`${id}-title`}
  class="rounded-xl border border-border bg-bg-subtle p-5 sm:p-6"
  data-pagefind-ignore
>
  <h2 id={`${id}-title`} class="flex items-center gap-2 text-lg font-semibold">
    <Icon name="sources" size={20} class="text-accent" />
    {title}
  </h2>
  {intro && <p class="mt-2 text-[0.9375rem] text-fg-muted">{intro}</p>}
  <ul class="mt-3 grid gap-x-8 gap-y-1 sm:grid-cols-2">
    {links.map((link) => (
      <li class="py-1">
        <a
          href={link.url}
          target="_blank"
          rel="noopener"
          class="link inline-block py-2.5 font-medium"
        >
          {link.name}
          <Icon name="external" size={15} class="ml-0.5 inline-block align-[-2px]" />
          <span class="visually-hidden">(opens in a new tab)</span>
        </a>
        <p class="text-sm text-fg-muted">{link.note}</p>
      </li>
    ))}
  </ul>
</section>
