---
// Layout for text pages such as About, the policies and the legal pages.
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { formatDate, isoDate } from '../lib/format';
import { breadcrumbSchema, type JsonLd } from '../lib/schema';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  /** Short lead paragraph under the title. */
  lead?: string;
  updated?: Date;
  /** Legal pages pass false so the AdSense script never loads on them. */
  ads?: boolean;
  /** Include this page in site search. */
  searchable?: boolean;
  jsonLd?: JsonLd[];
}

const {
  title,
  description,
  lead,
  updated,
  ads = true,
  searchable = false,
  jsonLd = [],
} = Astro.props;
const crumbs = [{ name: 'Home', href: '/' }, { name: title }];
---

<BaseLayout
  title={title}
  description={description}
  ads={ads}
  jsonLd={[...jsonLd, breadcrumbSchema(crumbs, Astro.url.pathname)]}
>
  <div class="border-b border-border bg-bg-subtle">
    <div class="container-page pt-2 pb-10">
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="mt-4 text-[2rem] leading-tight font-bold tracking-tight sm:text-[2.5rem]">
        {title}
      </h1>
      {lead && <p class="measure mt-4 text-lg text-fg-muted">{lead}</p>}
      {updated && (
        <p class="mt-4 text-[0.9375rem] text-fg-muted">
          Last updated <time datetime={isoDate(updated)}>{formatDate(updated, 'en-GB')}</time>
        </p>
      )}
    </div>
  </div>
  <div class="container-page pt-10">
    <div class="prose" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </div>
  </div>
</BaseLayout>
