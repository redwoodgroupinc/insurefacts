# Copy this file to .env for local development. Do NOT commit .env.

# Google AdSense publisher ID, e.g. ca-pub-1234567890123456.
# Leave empty (the default) and no ad code is loaded anywhere on the site.
PUBLIC_ADSENSE_CLIENT=

# ID of the display ad unit you create in AdSense (Ads → By ad unit), e.g. 1234567890.
# Ad slots only appear when both PUBLIC_ADSENSE_CLIENT and this are set.
PUBLIC_ADSENSE_SLOT=

# Set to true to include draft articles in a LOCAL preview build (never in production).
SHOW_DRAFTS=
